rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isAssignedRider(orderRiderId) {
      return isSignedIn() && orderRiderId is string &&
        request.auth.uid == orderRiderId;
    }
    function onlyRiderFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['riderLat', 'riderLng', 'status', 'updatedAt']);
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /foods/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promos/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == 'customer');
      allow update: if isSignedIn() && request.auth.uid == uid &&
        !('role' in request.resource.data && request.resource.data.role != resource.data.role);
      allow update: if isAdmin();
    }

    match /users/{uid}/notifications/{id} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == uid;
    }

    match /orders/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin() ||
        resource.data.get('riderId', '') == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.total ==
          request.resource.data.subtotal +
          request.resource.data.deliveryFee -
          request.resource.data.discount;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled') ||
        isAdmin() ||
        (isAssignedRider(resource.data.get('riderId', '')) && onlyRiderFields())
      );
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    match /foodImages/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
